<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WPF 程序必须用 net10.0-windows（带 -windows 才能用 WPF） -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FolderSentinel.App</RootNamespace>
    <AssemblyName>FolderSentinel</AssemblyName>
    <!-- UseWPF：窗口界面；UseWindowsForms：只为借用系统托盘图标控件（NotifyIcon） -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderSentinel.Core\FolderSentinel.Core.csproj" />
  </ItemGroup>

</Project>
