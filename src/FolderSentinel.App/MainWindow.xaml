<Window x:Class="FolderSentinel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="600" Width="920" MinHeight="520" MinWidth="780"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <!--
        界面设计说明（Windows 原生现代风，与工作区设计系统统一）：
        - 左侧 230px 导航栏 + 右侧白底卡片内容区；页面底色 #F3F4F6，卡片 #E3E6EA 细边框 8px 圆角；
        - 强调色 #0078D7（Windows 蓝）只用于选中态、主按钮和图标，禁止渐变大色块；
        - 悬停 / 按下 / 选中全部用 ControlTemplate Trigger 实现；
        - 图标用系统字体 Segoe MDL2 Assets（E72E 锁=守护、E9D2=监控、E8B7 文件夹=目录）；
        - 所有可见文字在后台代码里通过 Loc 翻译字典设置（中英双语），
          XAML 里唯一写死的文字是语言选择框里的“简体中文 / English”——
          每种语言的名字永远用它自己的语言显示，这是通用惯例。
    -->
    <Window.Resources>
        <!-- ============ 设计系统：Windows 原生现代风 ============ -->
        <!-- 卡片：白底、细边框、8px 圆角（不用投影，避免文字发虚） -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- 主按钮：强调色底、白字、悬停加深、按下更深 -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#0078D7" CornerRadius="6"
                                Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#AAB4BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮：白底细边框，悬停浅灰、按下更深 -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#1F2328"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#C9CFD6"
                                BorderThickness="1" CornerRadius="6" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EAED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E3E6EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏导航项：用 RadioButton 实现（天然有悬停 / 按下 / 选中三种状态） -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="12,10" Margin="0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9EDF2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DFE5EB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCEBF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 目录列表项：圆角高亮 + 悬停 / 选中 -->
        <Style x:Key="DirItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="10,6" Margin="4,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F8FC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCEBF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数据表格：原生紧凑风 -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F3"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FB"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#E3E6EA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!-- 行：悬停高亮 -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F8FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBF7"/>
                    <Setter Property="Foreground" Value="#1F2328"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 输入框统一高度 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#C9CFD6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 侧栏 ============ -->
        <DockPanel Grid.Column="0" Margin="14,14,6,14" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
                <!-- 应用标识：蓝色锁形图标 = “守护” -->
                <StackPanel Orientation="Horizontal" Margin="12,4,0,0">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="#0078D7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#1F2328"/>
                </StackPanel>

                <!-- 语言切换（简体中文 / English 是刻意例外：语言名用各自语言显示） -->
                <ComboBox x:Name="LangBox" Width="170" Height="28" Margin="12,14,0,0"
                          HorizontalAlignment="Left"
                          SelectionChanged="LangBox_SelectionChanged">
                    <ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem>
                    <ComboBoxItem Tag="en-US">English</ComboBoxItem>
                </ComboBox>

                <!-- 导航：RadioButton 互斥分组，天然支持悬停 / 按下 / 选中三态 -->
                <StackPanel Margin="12,18,0,0">
                    <RadioButton x:Name="NavEventsRadio" GroupName="NavPages" IsChecked="True"
                                 Style="{StaticResource NavItem}" Checked="NavRadio_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Foreground="#0078D7"/>
                            <TextBlock x:Name="NavEventsText" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDirsRadio" GroupName="NavPages"
                                 Style="{StaticResource NavItem}" Checked="NavRadio_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Foreground="#0078D7"/>
                            <TextBlock x:Name="NavDirsText" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>

            <!-- 侧栏底部：运行状态胶囊（绿点 = 监控中） -->
            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E3E6EA" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#0F7B0F" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusPillText" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- 占位撑开 -->
            <Grid/>
        </DockPanel>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Column="1" Margin="6,14,14,14">

            <!-- —— 页 1：实时事件 —— -->
            <Grid x:Name="PanelEvents">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具条卡片：关键字过滤 + 按天回看 + 回到实时；右侧本次计数 -->
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FilterLabel" VerticalAlignment="Center" Foreground="#6B7280"/>
                            <TextBox x:Name="FilterBox" Width="160" Margin="6,0,0,0"
                                     TextChanged="FilterBox_TextChanged"/>
                            <TextBlock x:Name="HistoryLabel" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#6B7280"/>
                            <DatePicker x:Name="HistoryDatePicker" Width="130" Height="28" Margin="6,0,10,0"
                                        SelectedDateChanged="HistoryDatePicker_SelectedDateChanged"/>
                            <Button x:Name="BackToLiveButton" Style="{StaticResource PrimaryBtn}"
                                    Click="BackToLiveButton_Click"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="CounterText" FontFamily="Consolas" FontSize="14"
                                       Foreground="#444444" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 事件表格卡片 + 中央空状态提示 -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DataGrid x:Name="EventGrid" ItemsSource="{Binding LiveRows}">
                            <DataGrid.Columns>
                                <!-- 时间列：右对齐 + 等宽字体，数字上下对齐好扫读 -->
                                <DataGridTextColumn x:Name="TimeColumn" Binding="{Binding Time}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn x:Name="KindColumn" Binding="{Binding Kind}" Width="60"/>
                                <DataGridTextColumn x:Name="PathColumn" Binding="{Binding Path}" Width="*" MinWidth="220"/>
                                <DataGridTextColumn x:Name="ProcessColumn" Binding="{Binding Process}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EventEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#B6BCC4" FontSize="13" IsHitTestVisible="False"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- —— 页 2：监控目录 —— -->
            <Grid x:Name="PanelDirs" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具条卡片：添加 / 删除 -->
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AddDirButton" Style="{StaticResource PrimaryBtn}"
                                Click="AddDirButton_Click"/>
                        <Button x:Name="RemoveDirButton" Style="{StaticResource SecondaryBtn}"
                                Margin="10,0,0,0" Click="RemoveDirButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- 目录列表卡片 + 中央空状态提示 -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ListBox x:Name="DirectoryList" BorderThickness="0" Background="Transparent"
                                 Padding="6" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource DirItem}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 勾选 = 监控该目录；取消勾选 = 暂停监控 -->
                                    <CheckBox Content="{Binding Path}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="DirEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#B6BCC4" FontSize="13" IsHitTestVisible="False"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
